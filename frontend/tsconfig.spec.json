{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine",
      "node"
    ],
    "typeRoots": [
      "src/typings",
      "node_modules/@types"
    ],
    "target": "ES2022",
    "strict": false,
    "allowUmdGlobalAccess": true,
    "noImplicitAny": false
  },
  "files": [
    "src/test.ts",
    "src/typings/karma-globals.d.ts",
    "src/typings.d.ts",
    
  ],
  "include": [
    "src/app/**/*.ts",
    "src/stimulus/**/*.ts",
    "src/typings/**/*.d.ts"
  ],
  "exclude": [
    "src/custom-elements/**",
    "src/react/**",
    "src/test-stubs/**",
    "src/**/*.vitest.ts",
    "src/**/*.vitest.spec.ts",
    "src/**/*.jest.ts",
    "src/**/*.jest.spec.ts"
  ]
}
