{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine"
     ]
  },
  "files": [
    "src/test.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/app/**/*.ts"
  ],
  "exclude": [
    "src/**/*.vitest.spec.ts",
    "src/**/__tests__/**/*",
    "src/test-stubs/**/*"
  ]
}
